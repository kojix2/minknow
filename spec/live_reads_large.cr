# Explicit integration suite: requires the updated proto.cr and grpc.cr and
# MinKNOW stubs regenerated by both updated plugins.
require "./spec_helper"

private class LargeLiveReadsPeer < GRPC::Service
  def service_full_name : String
    "minknow_api.data.DataService"
  end

  def dispatch(method : String, request_body : Bytes, ctx : GRPC::ServerContext) : {Bytes, GRPC::Status}
    {Bytes.empty, GRPC::Status.unimplemented}
  end

  def bidi_streaming?(method : String) : Bool
    method == "get_live_reads"
  end

  def dispatch_bidi_stream(method : String, requests : GRPC::RawRequestStream,
                           ctx : GRPC::ServerContext, writer : GRPC::RawResponseStream) : GRPC::Status
    requests.each do |bytes|
      request = Minknow::DataService::LiveRequest.decode(bytes)
      response = Minknow::DataService::LiveResponse.new
      if request.setup
        read = Minknow::DataService::ReadData.new
        read.id = "large-local-read"
        read.raw_data = Bytes.new(9 * 1024 * 1024, 42_u8)
        response.channels[3_u32] = read
      elsif actions = request.actions
        actions.actions.each do |action|
          reply = Minknow::DataService::ActionResponse.new
          reply.action_id = action.action_id
          response.action_responses << reply
        end
      end
      writer.send_raw(response.encode(options: Proto::EncodeOptions.new(max_field_length: 10 * 1024 * 1024)))
      return GRPC::Status.ok if request.actions
    end
    GRPC::Status.ok
  end
end

describe "MinKNOW live reads with a large signal field" do
  it "propagates per-call protobuf limits through setup, signal, action and completion" do
    listener = TCPServer.new("127.0.0.1", 0)
    port = listener.local_address.port
    listener.close
    server = GRPC::Server.new
    server.handle(LargeLiveReadsPeer.new)
    server.bind("127.0.0.1:#{port}")
    server.start
    channel = GRPC::Channel.new("http://127.0.0.1:#{port}")
    options = GRPC::ProtobufOptions.new(max_field_length: 10 * 1024 * 1024)
    ctx = GRPC::ClientContext.new(deadline: 15.seconds, protobuf_options: options)
    service = Minknow::DataService.new(channel, ctx)
    begin
      call = service.live_reads
      call.send(Minknow::DataService.setup_request(first_channel: 3, last_channel: 3))
      received_signal = false
      received_action = false
      call.each do |response|
        if read = response.channels[3_u32]?
          read.id.should eq("large-local-read")
          read.raw_data.should eq(Bytes.new(9 * 1024 * 1024, 42_u8))
          received_signal = true
          action = Minknow::DataService.stop_action("stop-large", 3_u32, read.id)
          call.send(Minknow::DataService.actions_request([action]))
        end
        received_action = true if response.action_responses.any? { |reply| reply.action_id == "stop-large" }
      end
      received_signal.should be_true
      received_action.should be_true
      call.final_status.should eq(GRPC::Status.ok)
    ensure
      channel.close
      server.stop
    end
  end
end
